{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Cookbench desktop windows receive live Stove events and expose an explicit drag handle.",
  "windows": ["main", "settings", "stove-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
